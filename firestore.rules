rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models & Schema Overview
    // ===============================================================
    //
    // 1. productos:
    //    - nombre: string (required)
    //    - precio: number (required)
    //    - categoria, imagen, stock, etc.
    //
    // 2. categorias / configuracion:
    //    - Categorías de catálogo y configuración de tasas (BCV/EUR)
    //
    // 3. web_destacados (Mini-CMS & Ofertas Black Friday):
    //    - nombre: string, precioRegular: number, precioOferta, mostrar_en_destacados: bool
    //
    // 4. web_banners (Mini-CMS Banners Promocionales y Carrusel Superior):
    //    - titulo: string, subtitulo: string, urlImagen: string, urlBoton: string,
    //      textoBoton: string, orden: number, activo: bool, fechaActualizacion: string, timestamp: number
    //
    // 5. facturas:
    //    - nro: string (required), total: number or string (required)
    //
    // 6. pedidos / envios:
    //    - Pedidos de compra web y logística de despacho
    //
    // 7. rutas_puntos / choferes_gps:
    //    - Puntos de entrega y coordenadas GPS en tiempo real
    //
    // 8. reventas_gastos / reventas:
    //    - Control de reventas, intermediarios, comisiones y cierre mensual
    //
    // 9. auditoria_logs:
    //    - Bitácora de trazabilidad de acciones operativas y administrativas
    //
    // 10. Gestión administrativa y financiera:
    //    - cotizaciones, cuentas_pagar, cxc_personal, importaciones, clientes,
    //      retenciones, administradores, usuarios, ai_copilot_sessions
    //
    // ===============================================================

    // ==========================================
    // FUNCIONES AUXILIARES DE SEGURIDAD
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // ==========================================
    // 1. CATÁLOGO PÚBLICO Y MINI-CMS WEB
    // ==========================================
    // Los productos y categorías son visibles para cualquier visitante (SEO y navegación),
    // pero su creación, actualización y eliminación requiere autenticación administrativa.
    match /productos/{productoId} {
      allow read: if true;
      allow create, update: if isAuthenticated() 
        && request.resource.data.nombre is string 
        && request.resource.data.precio is number;
      allow delete: if isAuthenticated();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Configuración general de la tienda (tasas oficiales BCV / EUR para conversión de precios)
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Mini-CMS: Repuestos Destacados y Ofertas Black Friday (Web pública)
    // Lectura pública para index.html / public.js; creación y edición restringidas a administradores
    match /web_destacados/{destacadoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Mini-CMS: Banners Promocionales y Carrusel Superior (Web pública)
    // Lectura pública para la portada web; creación y edición restringidas a administradores
    match /web_banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ==========================================
    // 2. COLECCIONES CRÍTICAS PROTEGIDAS
    // ==========================================
    // Facturación, Notas de entrega y Ventas: Autenticación obligatoria
    match /facturas/{facturaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() 
        && request.resource.data.nro is string 
        && (request.resource.data.total is number || request.resource.data.total is string);
      allow delete: if isAuthenticated();
    }

    // Pedidos de compra y envíos:
    // Lectura, creación y actualización habilitadas para compras web y operación de motorizados vía PIN
    match /pedidos/{pedidoId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Registro específico de envíos y paquetería
    match /envios/{envioId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 3. LOGÍSTICA Y CONTROL GPS DE MOTORIZADOS
    // ==========================================
    // Permite a la flota de choferes (vía PIN rápido) transmitir GPS y actualizar paradas
    match /rutas_puntos/{puntoId} {
      allow read, write: if true;
    }

    match /choferes_gps/{choferId} {
      allow read, write: if true;
    }

    // ==========================================
    // 4. MÓDULO DE REVENTAS Y CIERRE MENSUAL
    // ==========================================
    // Control de reventas, intermediarios, comisiones y gastos operativos
    match /reventas_gastos/{reventaId} {
      allow read, write: if isAuthenticated();
    }

    // Registros secundarios de reventa migrados desde pedidos
    match /reventas/{reventaId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 5. AUDITORÍA Y TRAZABILIDAD INTERNA
    // ==========================================
    // Bitácora de operaciones (Login, Logout, Creación, Modificación, Migración y Eliminación)
    match /auditoria_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 6. GESTIÓN FINANCIERA Y ADMINISTRATIVA
    // ==========================================
    match /cotizaciones/{cotizacionId} {
      allow read, write: if isAuthenticated();
    }

    match /cuentas_pagar/{cxpId} {
      allow read, write: if isAuthenticated();
    }

    match /cxc_personal/{cxcId} {
      allow read, write: if isAuthenticated();
    }

    match /importaciones/{impId} {
      allow read, write: if isAuthenticated();
    }

    match /clientes/{clienteId} {
      allow read, write: if isAuthenticated();
    }

    match /retenciones/{retencionId} {
      allow read, write: if isAuthenticated();
    }

    match /administradores/{adminId} {
      allow read, write: if isAuthenticated();
    }

    match /usuarios/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /ai_copilot_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 7. BLOQUEO POR DEFECTO (REGLA RESIDUAL)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
